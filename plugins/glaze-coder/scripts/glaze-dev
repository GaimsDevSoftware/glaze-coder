#!/bin/zsh
# ─────────────────────────────────────────────────────────────────────────────
# glaze-dev, develop Glaze (Raycast) desktop apps for FREE with your own Claude Code.
#
# Glaze apps are ordinary Claude Code projects on disk. The only thing that costs
# Glaze credits is Glaze's BUILT-IN AI agent. This wrapper lets you:
#   • go from nothing to coding a new app with ONE command (`start`)
#   • create a BRAND NEW app without spending a single credit (`new`)
#   • run your OWN `claude` (your Claude subscription) in the app folder → 0 credits
#   • build/run the app locally with Glaze's bundled Node               → 0 credits
#
# Glaze itself says you own the app, the code and the content. This just edits
# that code with your own tools instead of Glaze's paid agent.
# ─────────────────────────────────────────────────────────────────────────────
emulate -L zsh
set -e
setopt null_glob
GLAZE_DEV_SELF="${0:A}"   # absolute path to this script (captured before function scope, where $0 becomes the function name)

# --- Find Glaze's data folder (handles profile-name variants) -----------------
GLAZE_BASE="${GLAZE_BASE:-}"
if [[ -z "$GLAZE_BASE" ]]; then
  for cand in \
    "$HOME/Library/Application Support/app.glaze.macos.main" \
    "$HOME/Library/Application Support/"app.glaze.macos.*(/N) ; do
    [[ -d "$cand/apps" ]] && { GLAZE_BASE="$cand"; break; }
  done
fi
if [[ -z "$GLAZE_BASE" || ! -d "$GLAZE_BASE/apps" ]]; then
  # setup/help should still be able to guide you even without Glaze installed.
  case "${1:-}" in
    setup|doctor|help|-h|--help|"") GLAZE_BASE="" ;;
    *)
      print -u2 "❌ Could not find Glaze. Set GLAZE_BASE manually, or open Glaze once."
      print -u2 "   New here? Run: glaze-dev setup"
      exit 1 ;;
  esac
fi

APPS_DIR="$GLAZE_BASE/apps"
AR_SKILLS="$GLAZE_BASE/agent-resources/current/.claude/skills"
AR_GUIDE="$GLAZE_BASE/agent-resources/current/GLAZE-APP-GUIDE.md"
NPMRC="$GLAZE_BASE/.npmrc"

# --- Find Raycast (v2 ships as "Raycast Beta.app", side by side with v1) ------
# Prints the app bundle path of the preferred install, or nothing if absent.
_raycast_app() {
  local d
  for d in \
    "/Applications/Raycast Beta.app" \
    "$HOME/Applications/Raycast Beta.app" \
    "/Applications/Raycast.app" \
    "$HOME/Applications/Raycast.app" ; do
    [[ -d "$d" ]] && { print -r -- "$d"; return 0; }
  done
  return 1
}

# --- Glaze's bundled Node (required: node >= 24) ------------------------------
node_bins=("$GLAZE_BASE"/node/runtime/*/bin(N))
if (( ${#node_bins} )); then
  export PATH="${node_bins[1]}:$PATH"
fi
# Let npm use the same policy as Glaze (without touching .npmrc)
[[ -f "$NPMRC" ]] && export NPM_CONFIG_USERCONFIG="$NPMRC"

# --- Helpers ------------------------------------------------------------------
_appmeta() { # <app-dir> -> "productName|name|id"
  local pj="$1/.glaze-sources/package.json"
  [[ -f "$pj" ]] || return 1
  node -e 'const p=require(process.argv[1]);process.stdout.write(`${p.productName||p.name||""}|${p.name||""}|${p.id||""}`)' "$pj" 2>/dev/null
}

_resolve() { # <query> -> echoes app source dir (.glaze-sources), or fails
  local q="$1" d meta pn nm id
  for d in "$APPS_DIR"/*(/N); do
    meta="$(_appmeta "$d")" || continue
    pn="${meta%%|*}"; id="${meta##*|}"; nm="${${meta#*|}%%|*}"
    local base="${d:t}"
    if [[ "$base" == "$q"* || "$pn:l" == "$q:l" || "$nm:l" == "$q:l" \
       || "$id" == "$q" || "$pn:l" == *"$q:l"* ]]; then
      print -r -- "$d/.glaze-sources"; return 0
    fi
  done
  return 1
}

_slug()  { print -r -- "${1:l}" | tr -cs 'a-z0-9' '-' | sed 's/^-*//;s/-*$//'; }
_genid() { LC_ALL=C tr -dc 'a-z0-9' </dev/urandom | head -c 8; }

# Links Glaze's built-in skills into your global ~/.claude/skills, so that YOUR
# claude gets the same Glaze knowledge as Glaze's own agent. Idempotent.
_link_skills() {
  [[ -d "$AR_SKILLS" ]] || return 0
  mkdir -p "$HOME/.claude/skills"
  local s
  for s in "$AR_SKILLS"/*(/N); do
    ln -sfn "$s" "$HOME/.claude/skills/${s:t}"
  done
  [[ -f "$AR_GUIDE" ]] && ln -sfn "$AR_GUIDE" "$HOME/.claude/skills/GLAZE-APP-GUIDE.md"
}

_need() { # <query> -> sets $SRC and $ROOT, or exits
  local q="$1"
  [[ -n "$q" ]] || { print -u2 "❌ Missing app name. Try: glaze-dev list"; exit 1; }
  SRC="$(_resolve "$q")" || { print -u2 "❌ Found no app matching '$q'. Try: glaze-dev list"; exit 1; }
  ROOT="${SRC:h}"
}

# Sync the app's OWN icon into the launcher bundle and .glaze/ after a build, so
# apps cloned from a template don't keep the template's icon. Preserves
# entitlements when re-signing. Idempotent (does nothing when the icon matches).
_sync_icon() { # <src-dir (.glaze-sources)>
  local src="$1" root="${1:h}"
  local icns="$src/app-icon.icns"
  [[ -f "$icns" ]] || return 0
  local meta="$(_appmeta "$root")"; local prod="${meta%%|*}"
  local bundle="/Applications/Glaze/${prod}.app"
  # safety check: the bundle must point back at THIS app
  [[ -d "$bundle" ]] || return 0
  local runtime="$(readlink "$bundle/Contents/Resources/glaze-runtime" 2>/dev/null)"
  [[ "$runtime" == "$root/.glaze" ]] || return 0
  # .glaze/app-icon.icns (Glaze Store review expects this one)
  if [[ -d "$root/.glaze" ]] && ! cmp -s "$icns" "$root/.glaze/app-icon.icns"; then
    cp "$icns" "$root/.glaze/app-icon.icns"
  fi
  # the launcher bundle's icon
  if ! cmp -s "$icns" "$bundle/Contents/Resources/app-icon.icns"; then
    cp "$icns" "$bundle/Contents/Resources/app-icon.icns"
    local ent="$(mktemp)"
    codesign -d --entitlements "$ent" --xml "$bundle" 2>/dev/null || true
    if [[ -s "$ent" ]]; then
      codesign --force -s - --entitlements "$ent" "$bundle" 2>/dev/null || true
    else
      codesign --force -s - "$bundle" 2>/dev/null || true
    fi
    rm -f "$ent"
    touch "$bundle"
    print -r -- "✓ Icon synced into ${bundle:t}"
  fi
}

# --- Commands -----------------------------------------------------------------
cmd_list() {
  print -r -- "Glaze apps (in $APPS_DIR):"
  local d meta
  for d in "$APPS_DIR"/*(/N); do
    meta="$(_appmeta "$d")" || continue
    printf "  • %-24s  [folder: %s]\n" "${meta%%|*}" "${d:t}"
  done
}

# --- Agents (Claude Code, Codex, OpenCode, Gemini, desktop IDEs) --------------
# Is an app installed? (by bundle id)
_app_present() { mdfind "kMDItemCFBundleIdentifier == '$1'" 2>/dev/null | grep -q . ; }

# Build an AGENTS.md bridge for agents that read it (Codex/OpenCode/Gemini), so
# they get the same Glaze context CLAUDE.md gives Claude Code. Idempotent.
_ensure_agents_md() {
  local src="$1"
  [[ -e "$src/AGENTS.md" ]] && return 0
  [[ -f "$src/CLAUDE.md" ]] && ln -s "CLAUDE.md" "$src/AGENTS.md" 2>/dev/null || true
}

# Start the chosen agent in the app folder.  $1=agent  $2=source dir  rest=prompt
_launch_agent() {
  local agent="$1" src="$2"; shift 2
  local prompt="$*"
  cd "$src"
  case "$agent" in
    claude)
      _link_skills
      print -r -- "▶ Claude Code in: $src  (no Glaze credits)"
      [[ -n "$prompt" ]] && exec claude "$prompt" || exec claude ;;
    codex)
      _ensure_agents_md "$src"; print -r -- "▶ Codex in: $src"
      [[ -n "$prompt" ]] && exec codex "$prompt" || exec codex ;;
    opencode)
      _ensure_agents_md "$src"; print -r -- "▶ OpenCode in: $src"; exec opencode ;;
    gemini)
      _ensure_agents_md "$src"; print -r -- "▶ Gemini in: $src"; exec gemini ;;
    codex-app)     open -b com.openai.codex "$src"           && print -r -- "▶ Opened the Codex app on the folder" || print -u2 "❌ Could not open the Codex app" ;;
    opencode-app)  open -b ai.opencode.desktop "$src"        && print -r -- "▶ Opened the OpenCode app"            || print -u2 "❌ Could not open the OpenCode app" ;;
    antigravity)   open -b com.google.antigravity-ide "$src" && print -r -- "▶ Opened Antigravity IDE on the folder" || print -u2 "❌ Could not open Antigravity" ;;
    zcode)         _open_zcode "$src" "${${(s:|:)$(_appmeta "$ROOT")}[1]:-${ROOT:t}}" "$prompt" ;;
    *) print -u2 "❌ Unknown agent: $agent  (see: glaze-dev agents)"; exit 1 ;;
  esac
}

cmd_code() { # open the chosen agent in the app folder (free iteration)
  local agent="${GLAZE_AGENT:-claude}"
  local -a pos
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --agent|--tool) agent="$2"; shift 2 ;;
      --claude|--codex|--opencode|--gemini) agent="${1#--}"; shift ;;
      --codex-app|--opencode-app|--antigravity|--zcode) agent="${1#--}"; shift ;;
      *) pos+=("$1"); shift ;;
    esac
  done
  _need "${pos[1]}"
  _launch_agent "$agent" "$SRC" "${pos[2,-1]}"
}

cmd_agents() {
  print -r -- "Agents for:  glaze-dev code <app> --agent <name>    (default: claude)"
  print -r -- ""
  local a
  for a in claude codex opencode gemini; do
    command -v "$a" >/dev/null 2>&1 && printf "  ✓ %-13s CLI\n" "$a" || printf "  - %-13s (not found)\n" "$a"
  done
  _app_present com.openai.codex           && printf "  ✓ %-13s desktop app\n" "codex-app"
  _app_present ai.opencode.desktop        && printf "  ✓ %-13s desktop app\n" "opencode-app"
  _app_present com.google.antigravity-ide && printf "  ✓ %-13s desktop IDE (opens the folder)\n" "antigravity"
  _app_present dev.zcode.app              && printf "  ✓ %-13s desktop IDE (opens the folder)\n" "zcode"
  print -r -- ""
  print -r -- "Set the default agent:  export GLAZE_AGENT=codex   (put it in ~/.zshrc)"
  print -r -- "Codex/OpenCode/Gemini get Glaze context via an AGENTS.md bridge in the app folder."
}

cmd_build()   { _need "$1"; cd "$SRC"; print "▶ Building $1..."; npm run build; _sync_icon "$SRC"; }
cmd_dev()     { _need "$1"; cd "$SRC"; print "▶ Dev server for $1 (Ctrl-C to stop)..."; npm run dev; }
cmd_check()   { _need "$1"; cd "$SRC"; npm run type-check; }
cmd_lint()    { _need "$1"; cd "$SRC"; npm run lint; }
cmd_run()     { _need "$1"; local app=("$ROOT"/*.app(N)); (( ${#app} )) && open "${app[1]}" || open "$SRC/../"*.app; }
cmd_buildrun(){ cmd_build "$1"; cmd_run "$1"; }
cmd_path()    { _need "$1"; print -r -- "$SRC"; }
cmd_finder()  { _need "$1"; open "$SRC"; }

_setup_ask() {
  local def="$1" prompt="$2" ans
  if [[ ! -t 0 ]]; then
    case "${GLAZE_CLAUDE:-}" in
      1|true|yes) return 0 ;;
      *) return 1 ;;
    esac
  fi
  local hint="[y/N]"; [[ "$def" == y ]] && hint="[Y/n]"
  read "ans?   $prompt $hint: "
  [[ -z "$ans" ]] && ans="$def"
  [[ "$ans" == [Yy]* ]]
}

_install_claude_code() {
  command -v npm >/dev/null 2>&1 || return 1
  print "   Installing Claude Code with npm..."
  npm install -g @anthropic-ai/claude-code >/dev/null 2>&1
}

_install_claude_plugin() {
  command -v claude >/dev/null 2>&1 || return 1
  print "   This installs plugin code from the GaimsDevSoftware/glaze-coder marketplace."
  print "   Install it only if you trust that repository and its future updates."
  claude plugin marketplace add GaimsDevSoftware/glaze-coder >/dev/null 2>&1 || true
  claude plugin install glaze-coder >/dev/null 2>&1 \
    || claude plugin install glaze-coder@glaze-coder-marketplace >/dev/null 2>&1
}

# Interactive onboarding and health check: verifies the whole setup step by
# step, auto-fixes the safe local pieces, explains the AI engine choices, and
# points at the next step wherever something still needs the user.
cmd_setup() {
  local pass="%F{green}✓%f" fail="%F{red}✗%f" note="%F{yellow}!%f"
  local ready=1
  print -P "%B== glaze-dev setup: requirements, auto-fix and health check ==%b"
  print ""

  # 1) Machine
  if [[ "$(uname -m)" == arm64 ]]; then
    print -P "$pass Apple Silicon Mac"
  else
    print -P "$fail Apple Silicon (arm64) is required. This machine: $(uname -m)"
    ready=0
  fi

  # 2) Glaze itself
  if [[ -n "$GLAZE_BASE" && -d "$GLAZE_BASE/apps" ]]; then
    local napps; napps="$(ls -1 "$APPS_DIR" 2>/dev/null | wc -l | tr -d ' ')"
    print -P "$pass Glaze is installed ($napps app(s))"
    if (( napps == 0 )); then
      print -P "$note Glaze has no apps yet."
      print "   Requirement: create one app in Glaze first, then run setup again."
      ready=0
    fi
  else
    print -P "$fail Glaze is not installed (or has never been opened)."
    if [[ -d "/Applications/Glaze.app" || -d "$HOME/Applications/Glaze.app" ]]; then
      print "   Glaze.app exists, but its data/runtime is not ready yet."
      print "   Opening Glaze now. Finish onboarding there, then run: glaze-dev setup"
      open -a Glaze 2>/dev/null || true
    else
      print "   Requirement: install Glaze from https://www.glaze.app, open it once, and create at least one app."
    fi
    ready=0
  fi

  # 3) Bundled Node (required for free local builds)
  if command -v node >/dev/null 2>&1 && [[ "$(node -v 2>/dev/null)" == v2[4-9]* ]]; then
    print -P "$pass Node $(node -v) (Glaze's bundled runtime)"
  else
    print -P "$fail Could not find Glaze's Node >= 24 on PATH."
    print "   Requirement: open Glaze once and let it finish downloading its runtime."
    ready=0
  fi

  # 4) Claude Code (free development on your subscription)
  if command -v claude >/dev/null 2>&1; then
    print -P "$pass Claude Code $(claude --version 2>/dev/null | head -1)"
    print "   Note: --version does not prove login. Never logged in? Run: claude"
  else
    print -P "$fail Claude Code is not installed."
    if _setup_ask y "Install Claude Code now with npm?"; then
      if _install_claude_code && command -v claude >/dev/null 2>&1; then
        print -P "$pass Installed Claude Code"
        print "   Requirement after install: run 'claude' once to log in."
        ready=0
      else
        print -P "$fail Could not install Claude Code automatically."
        print "   Requirement: install it from https://claude.com/product/claude-code and run 'claude' to log in."
        ready=0
      fi
    else
      print "   Requirement: install it from https://claude.com/product/claude-code and run 'claude' to log in."
      print "   Without it, development costs Glaze credits; with it, it is free on your subscription."
      ready=0
    fi
  fi

  # 5) Glaze skills linked into ~/.claude
  local nlinked=0
  [[ -d "$HOME/.claude/skills" ]] && nlinked="$(ls -1 "$HOME/.claude/skills" 2>/dev/null | grep -c "^glaze" || true)"
  if (( nlinked > 5 )); then
    print -P "$pass Glaze skills linked into ~/.claude/skills ($nlinked)"
  else
    if [[ -d "$AR_SKILLS" ]]; then
      print -P "$note Glaze skills were missing; linking them now."
      _link_skills
      nlinked=0
      [[ -d "$HOME/.claude/skills" ]] && nlinked="$(ls -1 "$HOME/.claude/skills" 2>/dev/null | grep -c "^glaze" || true)"
      if (( nlinked > 5 )); then
        print -P "$pass Linked Glaze skills into ~/.claude/skills ($nlinked)"
      else
        print -P "$fail Could not link Glaze skills"
        ready=0
      fi
    else
      print -P "$note Glaze skills are not available yet."
      print "   Requirement: open Glaze once so it downloads agent resources, then run: glaze-dev setup"
      ready=0
    fi
  fi

  # 6) Claude Code plugin
  if command -v claude >/dev/null 2>&1; then
    if claude plugin list 2>/dev/null | grep -q "glaze-coder"; then
      print -P "$pass The Claude Code plugin (/glaze-coder:glaze) is installed"
    else
      print -P "$note The Claude Code plugin is missing."
      print "   It is optional, and pulls code from the GaimsDevSoftware/glaze-coder marketplace."
      if _setup_ask n "Install the Claude Code plugin now?"; then
        if _install_claude_plugin; then
          print -P "$pass Installed the Claude Code plugin (/glaze-coder:glaze)"
        else
          print -P "$fail Could not install the Claude Code plugin automatically."
          print "   Requirement: run: claude plugin install glaze-coder"
          ready=0
        fi
      else
        print "   Skipped. To install later, run: claude plugin install glaze-coder"
      fi
    fi
  fi

  # 7) Raycast (optional)
  local rc_app; rc_app="$(_raycast_app || true)"
  if [[ -n "$rc_app" ]]; then
    print -P "$pass ${rc_app:t:r} found. Set up the commands with: glaze-dev raycast"
  else
    print -P "$note Raycast not found (optional). Everything works fine without it."
  fi

  # 8) AI in the apps you build
  print ""
  print -P "%BAI engines in the apps you build:%b"
  print "  Apps made with glaze-coder let the end user choose whether AI costs anything:"
  print "  - Glaze AI       built in, zero setup, uses the user's Glaze credits"
  print "  - Google Gemini  free with their own key (https://aistudio.google.com/apikey)"
  print "  - OpenRouter     free models with their own key (low daily quota)"
  print "  - Claude Code    free through the user's Claude subscription (local CLI)"
  print "  Out of Glaze credits? The backup engine switches to a configured free engine."
  print ""
  if (( ready )); then
    print -P "%BReady. Next step:%b  glaze-dev start \"My App\"    (new app + Claude Code, 0 credits)"
  else
    print -P "%BStill required before everything works:%b"
    print "  - Glaze installed, opened once, and with at least one app"
    print "  - Glaze runtime/agent resources downloaded by Glaze"
    print "  - Claude Code installed and logged in for free local development"
    print ""
    print "Run this again any time: glaze-dev setup"
  fi
}

# Read out the queued (paused) prompts from the Glaze vibe coder's chat window
# for an app. The queue only lives in the Glaze UI's memory (not in db/localStorage),
# so we read it from the accessibility tree. CSS truncation does not truncate the
# DOM text, so we get the full text. Best effort: requires Glaze to be open with
# the app's chat window.
cmd_queue() {
  _need "$1"
  local meta="$(_appmeta "$ROOT")"; local prod="${meta%%|*}"
  osascript -l JavaScript - "$prod" <<'JXA'
function run(argv) {
  const title = argv[0];
  const se = Application('System Events');
  let proc;
  try { proc = se.processes.byName('Glaze'); proc.windows(); }
  catch (e) { return 'GLAZE_NOT_RUNNING'; }
  let win = null;
  for (const w of proc.windows()) { try { if (w.name() === title) { win = w; break; } } catch (e) {} }
  if (!win) return 'NO_WINDOW';
  const texts = [];
  let markerY = null;
  (function walk(el, d) {
    if (d > 60) return;
    let kids; try { kids = el.uiElements(); } catch (e) { return; }
    for (const k of kids) {
      let role = '', title = '';
      try { role = k.role(); } catch (e) {}
      try { title = String(k.title() || ''); } catch (e) {}
      // The queue's markers are buttons ("2 Queued Paused" / "Click to resume queue").
      if (/resume queue|\d+ Queued/i.test(title)) {
        try { const p = k.position(); if (p && (markerY === null || p[1] < markerY)) markerY = p[1]; } catch (e) {}
      }
      if (role === 'AXStaticText') {
        try {
          const v = k.value();
          if (v) { const p = k.position(); texts.push({ v: v, y: p ? p[1] : 0 }); }
        } catch (e) {}
      }
      walk(k, d + 1);
    }
  })(win, 0);
  if (markerY === null) return 'NO_QUEUE';
  const chrome = /resume queue|\d+ Queued|Describe your next change|credits left|Top up|^\s*Paused\s*$/i;
  const items = texts
    .filter(t => t.y >= markerY && !chrome.test(t.v) && t.v.trim().length > 40)
    .sort((a, b) => a.y - b.y)
    .map(t => t.v.trim());
  if (!items.length) return 'NO_QUEUE';
  return items.map((t, i) => (i + 1) + '. ' + t).join('\n\n');
}
JXA
}

# The handoff prompt an agent gets when we take over an app where the Glaze vibe
# coder left off. Agent-independent (Claude Code, ZCode, ...). The base text lives
# in one place; here we add any paused Glaze queue on top. Used both from here and
# from the Raycast script.
_handoff_base() { # <display name> -> base text without the queue
  printf '%s' "Continue the work on the Glaze app '$1' where the previous session left off (e.g. interrupted by running out of Glaze credits). Read .glaze_memory/PROJECT-CONTEXT.md and PROJECT-HISTORY.md, run npm run type-check, look at recently changed files, and finish whatever was in progress."
}
cmd_handoff() { # <app> -> print the full handoff prompt (base text + any queue)
  _need "$1"
  local meta="$(_appmeta "$ROOT")"; local prod="${meta%%|*}"; [[ -n "$prod" ]] || prod="$1"
  local h="$(_handoff_base "$prod")"
  local q; q="$(cmd_queue "$1" 2>/dev/null)" || q=""
  case "$q" in
    GLAZE_NOT_RUNNING|NO_WINDOW|NO_QUEUE|"") ;;
    *) h="$h"$'\n\n'"The Glaze vibe coder had these tasks queued up when it stopped - do them in order:"$'\n\n'"$q" ;;
  esac
  printf '%s' "$h"
}

# Seamless ZCode opening: open the app folder as a ZCode workspace via ZCode's own
# deep link, start a fresh thread (Cmd+N) and paste the handoff prompt into the text
# box (Cmd+V). We never press Enter - the user reviews it and sends it themselves.
# Auto-pasting requires Accessibility access; without it we fall back gracefully to
# the clipboard.
#   $1 = .glaze-sources path   $2 = display name   $3 = optional custom prompt
_open_zcode() {
  local src="$1" name="$2" custom="$3"
  local handoff
  if [[ -n "$custom" ]]; then
    handoff="$custom"
  else
    handoff="$(cmd_handoff "$name" 2>/dev/null)" || handoff=""
    [[ -n "$handoff" ]] || handoff="$(_handoff_base "$name")"
  fi
  printf '%s' "$handoff" | pbcopy

  local was_running=0; pgrep -x ZCode >/dev/null 2>&1 && was_running=1 || true
  local enc; enc="$(python3 -c 'import sys,urllib.parse; print(urllib.parse.quote(sys.argv[1], safe=""))' "$src")"
  open "zcode://workspace/open?path=$enc" 2>/dev/null \
    || open -a ZCode "$src" 2>/dev/null || open -a ZCode 2>/dev/null || true

  local tries=0
  while ! pgrep -x ZCode >/dev/null 2>&1 && (( tries < 40 )); do sleep 0.3; (( tries++ )) || true; done
  (( was_running )) && sleep 0.4 || sleep 2.5

  # Why this is more than a timer: ZCode's deep link first shows a native
  # confirmation sheet ("open this workspace?") on the window. The text box does
  # NOT exist before the user approves. So we raise ZCode, WAIT for a sheet to
  # possibly appear, then WAIT until the user has closed it (however long that
  # takes), and only then paste into a fresh thread. Never Enter - the user sends.
  local result
  result="$(osascript <<'APPLESCRIPT'
on hasSheet()
  try
    tell application "System Events" to tell process "ZCode"
      repeat with w in windows
        if (count of sheets of w) > 0 then return true
      end repeat
    end tell
  end try
  return false
end hasSheet

on run
  try
    tell application "System Events" to set frontmost of process "ZCode" to true
  on error
    return "ERR"
  end try
  set frontOk to false
  repeat 80 times
    try
      tell application "System Events" to set frontOk to (frontmost of process "ZCode")
    on error
      return "ERR"
    end try
    if frontOk then exit repeat
    delay 0.15
  end repeat
  if not frontOk then return "NOFOCUS"

  -- Look for a confirmation sheet for ~3 s; if one appears, wait (up to ~2 min)
  -- until the user has closed it. Then, and only then, the workspace and text box
  -- are ready.
  set sawSheet to false
  repeat 20 times
    if hasSheet() then
      set sawSheet to true
      exit repeat
    end if
    delay 0.15
  end repeat
  if sawSheet then
    repeat 800 times
      if not hasSheet() then exit repeat
      delay 0.15
    end repeat
    if hasSheet() then return "PENDING"
    delay 1.2
  end if

  delay 0.4
  try
    tell application "System Events"
      keystroke "n" using command down
      delay 0.7
      keystroke "a" using command down
      delay 0.15
      keystroke "v" using command down
    end tell
  on error
    return "ERR"
  end try
  return "PASTED"
end run
APPLESCRIPT
)" || result="ERR"

  if [[ "$result" == PASTED ]]; then
    print -r -- "▶ Opened ZCode on '$name' with a new thread and the handoff pasted in. Press Enter there to start."
    osascript -e "display notification \"Opened $name in ZCode with a new thread and handoff. Press Enter to send.\" with title \"Glaze: Edit $name\"" 2>/dev/null || true
  else
    print -r -- "▶ Opened ZCode on '$name'. The handoff is on the clipboard. Press Cmd+N then Cmd+V to paste it in."
    print -r -- "  (Auto-pasting requires Accessibility access for the app running this, under System Settings > Privacy & Security.)"
    osascript -e "display notification \"Opened $name in ZCode. Press Cmd+N then Cmd+V for the handoff (it is on the clipboard).\" with title \"Glaze: Edit $name\"" 2>/dev/null || true
  fi
}

cmd_skills()  { _link_skills; print "✓ Glaze skills linked into ~/.claude/skills"; }

# Help with the Raycast setup (Raycast has no deep link for adding a script
# directory, so this does the least possible: copies the path, opens Raycast).
cmd_raycast() {
  local rc="${GLAZE_DEV_SELF:h}/raycast"
  [[ -d "$rc" ]] || { print -u2 "❌ Fant ikke Raycast-mappen: $rc"; exit 1; }
  local rc_app; rc_app="$(_raycast_app || true)"
  local rc_name="${rc_app:t:r}"; : "${rc_name:=Raycast}"
  command -v pbcopy >/dev/null 2>&1 && printf '%s' "$rc" | pbcopy
  [[ -n "$rc_app" ]] && { open -a "$rc_app" 2>/dev/null || true; }
  osascript -e 'display notification "Add Directories, then Cmd+Shift+G and paste" with title "glaze-dev: Raycast"' 2>/dev/null || true
  print -r -- "Path copied to the clipboard:"
  print -r -- "  $rc"
  print -r -- ""
  print -r -- "In Raycast: Settings > Extensions > Script Commands > Add Directories,"
  print -r -- "press Cmd+Shift+G, paste (Cmd+V), Enter, then Open."
}

# Generate a simple, unique app icon: initials on a color gradient derived
# deterministically from the product name. macOS tools only (qlmanage/sips/iconutil),
# no AI, no cost. Writes app-icon.png + app-icon.icns in the source folder;
# _sync_icon carries them on into the launcher bundle at build time.
_gen_icon() { # <src-dir> <product-name>
  local src="$1" prod="$2"
  local tmp; tmp="$(mktemp -d)" || return 1
  local init; init="$(print -r -- "$prod" | awk '{a=substr($1,1,1); b=(NF>1)?substr($2,1,1):""; print toupper(a b)}' | tr -cd '[:alnum:]')"
  [[ -n "$init" ]] || init="A"
  local hue=$(( $(print -rn -- "$prod" | cksum | awk '{print $1}') % 360 ))
  local hue2=$(( (hue + 45) % 360 ))
  cat > "$tmp/icon.svg" <<EOF
<svg xmlns="http://www.w3.org/2000/svg" width="1024" height="1024">
<defs><linearGradient id="g" x1="0" y1="0" x2="1" y2="1">
<stop offset="0" stop-color="hsl($hue,75%,52%)"/><stop offset="1" stop-color="hsl($hue2,70%,36%)"/>
</linearGradient></defs>
<rect x="64" y="64" width="896" height="896" rx="200" fill="url(#g)"/>
<text x="512" y="655" font-family="Helvetica Neue,Helvetica" font-size="430" font-weight="bold" fill="white" text-anchor="middle">$init</text>
</svg>
EOF
  qlmanage -t -s 1024 -o "$tmp" "$tmp/icon.svg" >/dev/null 2>&1
  [[ -f "$tmp/icon.svg.png" ]] || { rm -rf "$tmp"; return 1; }
  local iconset="$tmp/app.iconset"; mkdir -p "$iconset"
  local s
  for s in 16 32 128 256 512; do
    sips -z $s $s "$tmp/icon.svg.png" --out "$iconset/icon_${s}x${s}.png" >/dev/null 2>&1
    sips -z $((s*2)) $((s*2)) "$tmp/icon.svg.png" --out "$iconset/icon_${s}x${s}@2x.png" >/dev/null 2>&1
  done
  iconutil -c icns "$iconset" -o "$tmp/app-icon.icns" 2>/dev/null || { rm -rf "$tmp"; return 1; }
  cp "$tmp/icon.svg.png" "$src/app-icon.png"
  cp "$tmp/app-icon.icns" "$src/app-icon.icns"
  rm -rf "$tmp"
  print -r -- "✓ Generated a custom icon ($init)"
}

# Regenerate the icon for an existing app and sync it into the bundle.
cmd_icon() {
  _need "$1"
  local meta="$(_appmeta "$ROOT")"
  _gen_icon "$SRC" "${meta%%|*}" || { print -u2 "❌ Icon generation failed"; exit 1; }
  _sync_icon "$SRC"
}

# SIMPLEST PATH: from nothing to coding. Creates a blank app (0 credits) and jumps
# straight into Claude Code with a starter message. One command, done.
cmd_start() {
  local agent="${GLAZE_AGENT:-claude}"
  local -a words
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --agent) agent="$2"; shift 2 ;;
      --claude|--codex|--opencode|--gemini) agent="${1#--}"; shift ;;
      *) words+=("$1"); shift ;;
    esac
  done
  local prod="${words[*]}"
  [[ -n "$prod" ]] || { print -u2 'Usage: glaze-dev start "<App name>" [--agent <name>]'; exit 1; }
  cmd_new "$prod" --blank --no-open
  local name="$(_slug "$prod")"
  cmd_code "$name" --agent "$agent" "This is a new, empty Glaze app called '$prod'. Read the local Glaze guide (CLAUDE.md/AGENTS.md) and the relevant skills, ask me briefly what the app should do, and build it out. Only change things in .glaze-sources, build with 'npm run build', and open the app to show the result."
}

# Create a BRAND NEW app without a single Glaze credit:
#   clone an existing app you own (template) → new id → build locally → build the
#   launcher bundle → ad-hoc sign → launch. No agent turn = no credits.
cmd_new() {
  local prod="" from="" blank=0 noopen=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --from)    from="$2"; shift 2 ;;
      --blank)   blank=1; shift ;;
      --no-open) noopen=1; shift ;;
      *) [[ -z "$prod" ]] && prod="$1" || prod="$prod $1"; shift ;;
    esac
  done
  [[ -n "$prod" ]] || { print -u2 '❌ Usage: glaze-dev new "<Product name>" [--from <app>] [--blank]'; exit 1; }

  # pick a template app (an existing app you own)
  local tsrc troot
  if [[ -n "$from" ]]; then
    tsrc="$(_resolve "$from")" || { print -u2 "❌ Could not find template app '$from'"; exit 1; }
  else
    local first=("$APPS_DIR"/*(/N))
    (( ${#first} )) || { print -u2 "❌ No existing Glaze app to use as a template. Create one in Glaze first (the free tier is enough)."; exit 1; }
    tsrc="${first[1]}/.glaze-sources"
  fi
  troot="${tsrc:h}"
  local tmeta="$(_appmeta "$troot")"; local tprod="${tmeta%%|*}"
  local tbundle="/Applications/Glaze/${tprod}.app"
  [[ -d "$tbundle" ]] || { print -u2 "❌ Could not find template bundle: $tbundle"; exit 1; }

  local name="$(_slug "$prod")"; local id="$(_genid)"
  local folder="${name}-local-${id}"
  local new="$APPS_DIR/$folder"; local newsrc="$new/.glaze-sources"
  local bid="app.glaze.macos.${id}-local"
  local exe="${prod// /}"
  local newapp="/Applications/Glaze/${prod}.app"

  print -r -- "▶ New app: $prod  (id=$id, folder=$folder, template=$tprod)"

  # 1) clone the source (APFS copy-on-write), drop inheritance we don't want
  rm -rf "$new" 2>/dev/null
  cp -cR "$troot" "$new" 2>/dev/null || cp -R "$troot" "$new"
  rm -f  "$new"/*.app(N) 2>/dev/null
  rm -rf "$newsrc/.git" "$new/.glaze" 2>/dev/null
  rm -f  "$newsrc/.glaze_memory/PROJECT-HISTORY.md"(N) 2>/dev/null
  # icon identity must NOT be inherited: remove the hash marker so the Glaze agent
  # knows the icon was not generated for this app. The template icon itself stays
  # as a temporary placeholder until you swap app-icon.png/app-icon.icns.
  rm -f "$newsrc/.icon-hash"(N) 2>/dev/null
  # personal Claude Code permissions (may contain absolute paths with the user
  # name) and old worktrees must not be inherited either.
  rm -f  "$newsrc/.claude/settings.local.json"(N) 2>/dev/null
  rm -rf "$newsrc/.claude/worktrees"(N) 2>/dev/null

  # 2) new identity in package.json
  ( cd "$newsrc" && node -e 'const fs=require("fs");const j=JSON.parse(fs.readFileSync("package.json"));const[,id,name,prod]=process.argv;j.id=id;j.name=name;j.productName=prod;j.description="A Glaze app: "+prod;fs.writeFileSync("package.json",JSON.stringify(j,null,2))' "$id" "$name" "$prod" )

  # 2b) a custom icon from day one, so nothing inherits the template's look
  _gen_icon "$newsrc" "$prod" || print -r -- "! Icon generation failed, keeping the template icon for now"

  # 3) optionally blank out the UI
  if (( blank )); then
    local hv="$newsrc/renderer/main/home-view.tsx"
    if [[ -f "$hv" ]]; then
      cat > "$hv" <<EOF
export function HomeView() {
  return (
    <div className="flex h-full items-center justify-center">
      <p className="text-secondary">$prod, start building with Claude Code.</p>
    </div>
  );
}
EOF
    fi
  fi

  # 4) build locally (free)
  print -r -- "▶ Building locally..."
  ( cd "$newsrc" && npm run build ) >/dev/null 2>&1 || { print -u2 "❌ Build failed. Debug with: glaze-dev build $name"; exit 1; }

  # 5) launcher bundle (copy the template, point the symlink, patch identity)
  rm -rf "$newapp" 2>/dev/null
  cp -cR "$tbundle" "$newapp" 2>/dev/null || cp -R "$tbundle" "$newapp"
  mv "$newapp/Contents/MacOS/${tprod}" "$newapp/Contents/MacOS/${exe}" 2>/dev/null || true
  rm -f "$newapp/Contents/Resources/glaze-runtime"
  ln -s "$new/.glaze" "$newapp/Contents/Resources/glaze-runtime"
  local plist="$newapp/Contents/Info.plist"
  plutil -replace CFBundleExecutable  -string "$exe"  "$plist"
  plutil -replace CFBundleDisplayName -string "$prod" "$plist"
  plutil -replace CFBundleName        -string "$prod" "$plist"
  plutil -replace CFBundleIdentifier  -string "$bid"  "$plist"
  plutil -replace CFBundleURLTypes.0.CFBundleURLName      -string "$bid"               "$plist" 2>/dev/null || true
  plutil -replace CFBundleURLTypes.0.CFBundleURLSchemes.0 -string "glaze-${id}-local"  "$plist" 2>/dev/null || true

  # 6) ad-hoc sign (keep the entitlements from the template)
  local ent="$(mktemp)"
  codesign -d --entitlements "$ent" --xml "$tbundle" 2>/dev/null || true
  codesign --remove-signature "$newapp" 2>/dev/null || true
  if [[ -s "$ent" ]]; then
    codesign --force --deep -s - --entitlements "$ent" "$newapp" 2>/dev/null || true
  else
    codesign --force --deep -s - "$newapp" 2>/dev/null || true
  fi
  rm -f "$ent"

  # 7) sync the generated icon into the fresh bundle
  _sync_icon "$newsrc" || true

  print -r -- "✓ Created without credits: $newapp"
  print -r -- "The app got a generated icon. Swap it any time: drop a new app-icon.png +"
  print -r -- "app-icon.icns into .glaze-sources (or run glaze-dev icon $name again)."
  (( noopen )) || open "$newapp"
  print -r -- "Next: glaze-dev code $name \"build the app out like this:...\"  (free further development)"
}

# Remove an app completely (bundle, source, profile, logs). The counterpart to `new`.
cmd_rm() {
  _need "$1"
  local meta="$(_appmeta "$ROOT")"; local prod="${meta%%|*}"; local id="${meta##*|}"
  print -r -- "Removing '$prod' (folder=${ROOT:t}, id=$id)..."
  osascript -e "tell application \"$prod\" to quit" 2>/dev/null || true
  pkill -f "/Applications/Glaze/${prod}.app" 2>/dev/null || true
  sleep 1
  rm -rf "/Applications/Glaze/${prod}.app"
  rm -rf "$ROOT"
  rm -rf "$HOME/Library/Application Support/app.glaze.macos.${id}-local" 2>/dev/null || true
  rm -rf "$HOME/Library/Logs/app.glaze.macos.${id}-local" 2>/dev/null || true
  print -r -- "✓ Removed."
}

cmd_help() {
cat <<'EOF'
glaze-dev, free development of Glaze apps with your own Claude Code

SIMPLEST PATH (from nothing to coding, one command):
  glaze-dev start "My App"        Creates an empty app (0 credits) and opens Claude
                                  Code there, just describe what the app should do.

ALL COMMANDS:
  glaze-dev list                        List all Glaze apps
  glaze-dev start "<Name>"              New empty app + jump straight into Claude Code
  glaze-dev new   "<Name>" [--from <app>] [--blank] [--no-open]
                                        Create a new app without credits (without opening claude)
  glaze-dev code   <app> [--agent <name>] [prompt]
                                        Open the app folder in an agent (free).
                                        Agents: claude (default), codex, opencode,
                                        gemini, codex-app, opencode-app, antigravity, zcode
  glaze-dev agents                      List the agents you have installed
  glaze-dev dev    <app>                Dev server (live reload)
  glaze-dev build  <app>                Build (locally, free)
  glaze-dev run    <app>                Open the built app
  glaze-dev br     <app>                Build + run
  glaze-dev check  <app>                TypeScript type-check
  glaze-dev lint   <app>                ESLint
  glaze-dev path   <app>                Print the path to .glaze-sources
  glaze-dev queue  <app>                Read out paused prompts from the Glaze vibe coder
                                        (requires Glaze to be open with the app's chat)
  glaze-dev handoff <app>               Print the handoff prompt (base text + any queue)
  glaze-dev icon   <app>                Generate a new app icon (initials + gradient)
  glaze-dev finder <app>                Open the app folder in Finder
  glaze-dev rm     <app>                Remove the app completely (bundle+source+profile)
  glaze-dev raycast                     Set up Raycast (copy path + open Raycast)
  glaze-dev setup                       Onboarding/health check of the whole setup
  glaze-dev skills                      Link Glaze skills into ~/.claude/skills

<app> matches on folder name or product name (partial matches are fine).

Note: new apps are ad-hoc signed for your own use. Publishing to the public
Glaze Store still requires a Glaze login (free, not credits). `new`/`start`
use an app you already own as a template (--blank gives an empty UI you build out).
EOF
}

# --- Dispatch -----------------------------------------------------------------
cmd="${1:-help}"; shift || true
case "$cmd" in
  list)                 cmd_list ;;
  start|go)             cmd_start "$@" ;;
  new|create)           cmd_new "$@" ;;
  code|edit)            cmd_code "$@" ;;
  agents|agent)         cmd_agents ;;
  dev)                  cmd_dev "$@" ;;
  build)                cmd_build "$@" ;;
  run|open)             cmd_run "$@" ;;
  br|buildrun|build-run) cmd_buildrun "$@" ;;
  check|type-check)     cmd_check "$@" ;;
  lint)                 cmd_lint "$@" ;;
  path)                 cmd_path "$@" ;;
  icon)                 cmd_icon "$@" ;;
  queue)                cmd_queue "$@" ;;
  handoff)              cmd_handoff "$@" ;;
  finder|reveal)        cmd_finder "$@" ;;
  rm|delete|remove)     cmd_rm "$@" ;;
  raycast|raycast-setup) cmd_raycast "$@" ;;
  setup|doctor)         cmd_setup "$@" ;;
  skills|link-skills)   cmd_skills ;;
  help|-h|--help)       cmd_help ;;
  *) print -u2 "Unknown command: $cmd"; cmd_help; exit 1 ;;
esac
